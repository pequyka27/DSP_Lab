t= linspace(0,0.1,200);
x_a= 3*sin(100*%pi*t);

n= 1:30;
x= 3*sin(100*%pi*n/300);
xq= 0.1*fix(x/0.1);

clf();

subplot(1,3,1);
plot(t,x_a);
p_a = gce().children;
p_a.thickness = 2;
xlabel("t");
ylabel("x_a(t)");
xgrid();


subplot(1,3,2);
plot2d3(n,x);
p = gce().children;
p.thickness = 2;
p.mark_mode = "on";
p.mark_style = 9;
p.mark_size_unit = "point";
p.mark_size = 6;
p.mark_foreground = color("black");
p.mark_background = color("black");
xlabel("n");
ylabel("x(n)");
xgrid();

subplot(1,3,3);
plot2d3(n,xq);
p_q = gce().children;
p_q.thickness = 2;
p_q.mark_mode = "on";
p_q.mark_style = 9;
p_q.mark_size_unit = "point";
p_q.mark_size = 6;
p_q.mark_foreground = color("black");
p_q.mark_background = color("black");
xlabel("n");
ylabel("x_q(n)");
xgrid();
